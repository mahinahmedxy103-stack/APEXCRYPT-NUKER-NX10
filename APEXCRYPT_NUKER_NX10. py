            elif choice == "0":
                print(f"{Fore.RED}FULL NUKE CONFIG")
                cfg = {
                    "ban": input("Mass ban + DM? (y/n): ").lower() != "n",
                    "reason": input("Ban reason: ") or "APEXCRYPT NX10",
                    "dm_text": input("DM template {{user}} {{reason}}: ") or "[{user}] {reason}",
                    "del_ch": input("Delete channels? (y/n): ").lower() != "n",
                    "create_ch": input("Create channels? (y/n): ").lower() != "n",
                    "ch_prefix": input("Channel prefix: ") or "nuked",
                    "ch_amt": int(input("Channel amount: ") or "80"),
                    "del_roles": input("Delete roles? (y/n): ").lower() != "n",
                    "create_roles": input("Create roles? (y/n): ").lower() != "n",
                    "role_prefix": input("Role prefix: ") or "nuked",
                    "role_amt": int(input("Role amount: ") or "300"),
                    "del_emojis": input("Delete emojis? (y/n): ").lower() != "n",
