                amt = int(input(f"{Fore.CYAN}Amount: {Style.RESET_ALL}") or "100")
                await nuker.mass_channel_create(guild, prefix, amt)

            elif choice == "3":
                await nuker.mass_channel_delete(guild)

            elif choice == "4":
                prefix = input(f"{Fore.CYAN}Role prefix: {Style.RESET_ALL}") or "nuked"
                amt = int(input(f"{Fore.CYAN}Amount (500-700+ target): {Style.RESET_ALL}") or "500")
