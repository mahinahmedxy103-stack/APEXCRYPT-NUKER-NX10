                msg = input(f"{Fore.CYAN}Message: {Style.RESET_ALL}") or "@everyone APEXCRYPT NX10"
                amt = int(input(f"{Fore.CYAN}Msgs per channel (ultra): {Style.RESET_ALL}") or "30")
