async def main():
    clear()
    print(BANNER)
    print(f"{Fore.YELLOW}[*] APEXCRYPT NUKER NX10 boot...")
    token = input(f"{Fore.CYAN}[>] Token (bot / user / selfbot): {Style.RESET_ALL}").strip()
