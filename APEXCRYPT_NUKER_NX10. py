    if not token or not guild_id:
        print(f"{Fore.RED}[!] Token or Server ID missing → refusing to open.")
        time.sleep(2)
        sys.exit(1)

    nuker = Nuker(token, guild_id)
    await nuker.start_session()

    @nuker.bot.event
    async def on_ready():
        print(f"{Fore.GREEN}[+] Logged as {nuker.bot.user}")
        guild = nuker.bot.get_guild(nuker.guild_id)
        if not guild:
            print(f"{Fore.RED}[!] Server not found / no access. Closing.")
            await nuker.close_session()
            await nuker.bot.close()
            return

