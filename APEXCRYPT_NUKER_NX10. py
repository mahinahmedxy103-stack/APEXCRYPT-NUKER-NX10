class LiveRadar:
    def __init__(self):
        self.bans = 0
        self.channels_created = 0
        self.channels_deleted = 0
        self.roles_created = 0
        self.roles_deleted = 0
        self.emojis_created = 0
        self.emojis_deleted = 0
        self.messages_sent = 0
        self.webhooks_created = 0
        self.dms_sent = 0
        self.start_time = time.time()
        self.recent_bans = []
        self.recent_actions = []
        self.lock = asyncio.Lock()

    async def log_ban(self, user):
        async with self.lock:
            self.bans += 1
            name = str(user)
            self.recent_bans.append(name)
            if len(self.recent_bans) > 12:
                self.recent_bans.pop(0)
            self.recent_actions.append(f"{Fore.RED}[BAN] {name}")

    async def log_channel(self, action, name=""):
        async with self.lock:
            if action == "create":
                self.channels_created += 1
                self.recent_actions.append(f"{Fore.GREEN}[CH+] {name}")
            else:
                self.channels_deleted += 1
                self.recent_actions.append(f"{Fore.YELLOW}[CH-] {name}")

    async def log_role(self, action, name=""):
        async with self.lock:
            if action == "create":
                self.roles_created += 1
                self.recent_actions.append(f"{Fore.MAGENTA}[RL+] {name}")
            else:
                self.roles_deleted += 1
                self.recent_actions.append(f"{Fore.YELLOW}[RL-] {name}")

    async def log_emoji(self, action, name=""):
        async with self.lock:
            if action == "create":
                self.emojis_created += 1
                self.recent_actions.append(f"{Fore.CYAN}[EM+] {name}")
            else:
                self.emojis_deleted += 1
                self.recent_actions.append(f"{Fore.YELLOW}[EM-] {name}")

    async def log_msg(self):
        async with self.lock:
            self.messages_sent += 1

    async def log_dm(self):
        async with self.lock:
            self.dms_sent += 1

    async def log_webhook(self):
        async with self.lock:
            self.webhooks_created += 1

    def render(self):
        elapsed = int(time.time() - self.start_time)
        os.system('cls' if os.name == 'nt' else 'clear')
        print(BANNER)
        print(f"{Fore.CYAN}╔════════════════════════════ LIVE RADAR MATRIX NX10 ════════════════════════════╗")
        print(f"{Fore.CYAN}║ {Fore.WHITE}Runtime {elapsed:>4}s │ Bans {Fore.RED}{self.bans:<5} {Fore.WHITE}│ CH+ {Fore.GREEN}{self.channels_created:<4} {Fore.WHITE}│ RL+ {Fore.MAGENTA}{self.roles_created:<4} {Fore.WHITE}│ EM+ {Fore.CYAN}{self.emojis_created:<3} {Fore.WHITE}│ MSG {Fore.YELLOW}{self.messages_sent:<5} {Fore.WHITE}│ DM {Fore.RED}{self.dms_sent:<4} {Fore.CYAN}║")
        print(f"{Fore.CYAN}╠════════════════════════════════════════════════════════════════════════════════╣")
        print(f"{Fore.CYAN}║ {Fore.RED}RECENT BANS (live):{Style.RESET_ALL}")
