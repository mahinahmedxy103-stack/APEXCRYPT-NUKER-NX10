            elif choice == "7":
                msg = input(f"{Fore.CYAN}Webhook msg: {Style.RESET_ALL}") or "@everyone APEXCRYPT"
                amt = int(input(f"{Fore.CYAN}Amount: {Style.RESET_ALL}") or "15")
